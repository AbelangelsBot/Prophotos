FROM node:18-alpine

WORKDIR /app

# Ensure dev server binds externally and file watching works in containers
ENV HOST=0.0.0.0
ENV CHOKIDAR_USEPOLLING=true

# Vue CLI dev server port (see vue.config.js)
EXPOSE 8082

# Install deps at container start; fall back to npm install if lockfile is missing
CMD ["sh", "-c", "if [ -f package-lock.json ]; then npm ci; else npm install; fi; npm run serve"]
