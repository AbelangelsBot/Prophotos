###############################################
# Stage 1: Build the Vue app with Node
###############################################
FROM node:20-alpine AS build

WORKDIR /app

# Copy package manifests and install deps
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy the rest of the sources
COPY . .

# Optional: allow overriding API URLs at build time
# Vue CLI only injects variables prefixed with VUE_APP_
ARG VUE_APP_USERS_API_URL
ARG VUE_APP_FILES_API_URL
ENV VUE_APP_USERS_API_URL=${VUE_APP_USERS_API_URL}
ENV VUE_APP_FILES_API_URL=${VUE_APP_FILES_API_URL}

# Build for production (outputs to /app/dist)
RUN npm run build

###############################################
# Stage 2: Serve the built app via Nginx
###############################################
FROM nginx:alpine

# Copy build output
COPY --from=build /app/dist /usr/share/nginx/html

# Default site config with SPA fallback
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
