FROM node:18-alpine

WORKDIR /app

# Ensure dev server binds externally and file watching works in containers
ENV HOST=0.0.0.0
ENV CHOKIDAR_USEPOLLING=true

# Vue CLI dev server port (see vue.config.js)
EXPOSE 8082

# Copy app sources so the image can run without host bind mounts
COPY package*.json ./
COPY . .

# Install deps at container start; fall back to npm install if lockfile is missing
# Run Vue dev server in production mode so it loads .env.production
CMD ["sh", "-c", "if [ -f package-lock.json ]; then npm ci; else npm install; fi; npx vue-cli-service serve --mode production"]
